# Copy this file to .env and fill in real values.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://omnisure:omnisure@localhost:5432/omnisure

# --- Auth ---
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- App ---
ENV=development
DEMO_MODE=true

# --- Future integrations (Phase 2+), leave blank for DEMO_MODE fallback ---
OPENAI_API_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
